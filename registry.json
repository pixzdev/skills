{
  "version": "1.0.0",
  "channel": "stable",
  "limits": {
    "max_skill_chain_depth": 12,
    "max_orchestration_depth": 6,
    "max_iterations": 8
  },
  "protocols": [
    { "id": "pixz.protocol.context", "name": "Context Protocol", "description": "What/where/authority/staleness/preservation; acquisition order workflow→repo→tools→docs→research→user.", "path": "docs/architecture.md" },
    { "id": "pixz.protocol.workflow", "name": "Workflow Propagation", "description": "Parent to child workflow inheritance and structured handoff.", "path": "schemas/workflow.schema.json" },
    { "id": "pixz.protocol.argumentation", "name": "Argumentation", "description": "Claim lifecycle: rationale, evidence, alternatives, counterarguments, falsification, confidence, status, revision.", "path": "core/epistemic-reasoning/SKILL.md" },
    { "id": "pixz.protocol.escalation", "name": "Escalation Ladder", "description": "retry → inspect → alternate → research → specialist → challenge → parent → user", "path": "core/replanning/SKILL.md" }
  ],
  "policies": [
    { "id": "pixz.policy.scope-control", "name": "Scope Control", "description": "Distinguish requested / necessary / optional / out-of-scope; no architecture rewrite for one-bug fixes without evidence.", "enforces": ["all"] },
    { "id": "pixz.policy.simplicity", "name": "Simplicity", "description": "Minimum necessary, not minimum possible; avoid unnecessary abstraction/deps/agents/tools.", "enforces": ["all"] },
    { "id": "pixz.policy.change-safety", "name": "Change Safety", "description": "Reversible / partially / irreversible tiers; stronger scrutiny for higher risk.", "enforces": ["all"] },
    { "id": "pixz.policy.anti-ai-slop", "name": "Anti-AI Slop", "description": "Diagnostic criteria, not dogmatic bans, for design/code/research/docs.", "enforces": ["design","frontend","engineering"] }
  ],
