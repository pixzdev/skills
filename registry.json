{
  "version": "2.1.0",
  "channel": "stable",
  "limits": {
    "max_skill_chain_depth": 15,
    "max_orchestration_depth": 6,
    "max_iterations": 8
  },
  "protocols": [
    {
      "id": "pixz.protocol.context",
      "name": "Context Protocol",
      "description": "Lifecycle discover→filter→prioritize→load→compress→pin→update→evict→restore; acquisition order task-state→repo→tools/MCP→docs→research→user; sufficiency stops acquisition.",
      "path": "core/context-engineering/SKILL.md"
    },
    {
      "id": "pixz.protocol.task-state",
      "name": "Task State & Continuity",
      "description": "One compact state file per task (schemas/task-state.schema.json); checkpoint discipline; deterministic resume protocol; state over phase; survives compaction/restart/handoff/model/runtime change.",
      "path": "schemas/task-state.schema.json"
    },
    {
      "id": "pixz.protocol.capability-activation",
      "name": "Capability Activation",
      "description": "Persistent skill invocation: discover→match→load (progressive)→activate→use→verify→persist→reinvoke; activation state lifecycle; budget rule — every activation earns its context cost.",
      "path": "core/capability-discovery/SKILL.md"
    },
    {
      "id": "pixz.protocol.source-of-record",
      "name": "Source-of-Record",
      "description": "Descriptive records (commits, logs, summaries, reports, docs, metadata) are never authoritative by appearance; system-state claims verify against actual filesystem/git/test output/artifacts/deployed state; verified_against recorded.",
      "path": "core/verification/SKILL.md"
    },
    {
      "id": "pixz.protocol.argumentation",
      "name": "Argumentation",
      "description": "Typed claims with explicit transitions (unknown→hypothesis→tested→supported; assumption→challenged→falsified; claim→evidence→verified); position change attribution.",
      "path": "core/epistemic-reasoning/SKILL.md"
    },
    {
      "id": "pixz.protocol.handoff-contract",
      "name": "Handoff Contract",
      "description": "Delegation economics test; structured dispatch; mandatory structured return (work, findings, evidence, assumptions, unknowns, decisions, tests, verification, remaining work, next action); parent inspection; no 'looks good' returns.",
      "path": "schemas/handoff.schema.json"
    },
    {
      "id": "pixz.protocol.escalation",
      "name": "Failure Recovery & Escalation",
      "description": "FAIL→CLASSIFY→INSPECT→ISOLATE→HYPOTHESIS→TEST→REPAIR→REGRESSION CHECK→CONTINUE; each retry adds information; ladder retry→inspect→alternate→research→specialist→challenge→parent→user.",
      "path": "core/replanning/SKILL.md"
    },
    {
      "id": "pixz.protocol.self-learning",
      "name": "Self-Learning Lifecycle",
      "description": "Post-install lifecycle DETECT→INVENTORY→BASELINE→ADAPT→VERIFY→PERSIST→READY plus in-work improvement loop OBSERVE→DIAGNOSE→CHALLENGE→IMPROVE→VERIFY→REGRESS→PERSIST→REUSE; adaptation state in .pixz/adaptation-state.json; second activation is a check, never a re-run; drift re-adapts only the delta.",
      "path": "core/self-learning/SKILL.md"
    },
    {
      "id": "pixz.protocol.verification-depth",
      "name": "Verification Depth",
      "description": "Verification depth must match the claim: EXISTS→existence check, PARSES→parser, SCHEMA-COMPLIANT→schema validation, CORRECT→behavioral verification, INTEGRATED→integration test, RUNTIME-ACTIVE→runtime invocation, PERSISTENT→repeated/delayed observation, IMPROVED→baseline comparison. Never substitute a weaker rung (file exists = valid, command succeeded = correct, test passed = requirement satisfied, agent said success = verified).",
      "path": "core/verification/SKILL.md"
    }
  ],
  "policies": [
    {
      "id": "pixz.policy.scope-control",
      "name": "Scope Control",
      "description": "Distinguish requested / necessary / optional / out-of-scope; no architecture rewrite for one-bug fixes without evidence.",
      "enforces": [
        "all"
      ]
    },
    {
      "id": "pixz.policy.simplicity",
      "name": "Simplicity",
      "description": "Minimum necessary, not minimum possible; avoid unnecessary abstraction/deps/agents/tools. Anti-overengineering gate: every new subsystem must answer what failure it prevents, what behavior it enables, what measurable improvement, what its cost, and whether simpler suffices. Applies to self-improvement: failures must not spawn new skills/agents/protocols/schemas/instruction files/dependencies unless existing mechanisms cannot express the fix, the failure class recurs, and the benefit justifies permanent cost (improvement-economy gate).",
      "enforces": [
        "all"
      ]
    },
    {
      "id": "pixz.policy.change-safety",
      "name": "Change Safety",
      "description": "Static policy (not routed): reversible / partially / irreversible tiers; irreversible/high-impact requires confirmation in every mode including autonomous.",
      "enforces": [
        "all"
      ]
    },
    {
      "id": "pixz.policy.orchestration-budget",
      "name": "Orchestration Budget",
      "description": "Every added capability, subagent, research pass or verification round must have expected value > context/coordination cost. Trivial tasks must stay cheap; a mode is an upper tendency, never a minimum ceremony.",
      "enforces": [
        "all"
      ]
    },
    {
      "id": "pixz.policy.anti-ai-slop",
      "name": "Anti-AI Slop",
      "description": "Diagnostic criteria, not dogmatic bans; never classify by surface trait alone — judge purpose and value.",
      "enforces": [
        "design",
        "frontend",
        "engineering"
      ]
    }
  ],
