{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pixz.dev/schemas/workflow.schema.json",
  "title": "PIXZ Workflow State",
  "description": "Logical workflow model — persisted differently per runtime (filesystem, memory, adapter).",
  "type": "object",
  "required": ["objective", "phase"],
  "properties": {
    "objective": { "type": "string" },
    "requirements": { "type": "array", "items": { "type": "string" } },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "phase": {
      "type": "string",
      "enum": ["DEFINE","DISCOVER","RESEARCH","PLAN","EXECUTE","INSPECT","CHALLENGE","VERIFY","REPLAN","IMPROVE","SHIP"]
    },
    "completed_work": { "type": "array", "items": { "type": "string" } },
    "pending_work": { "type": "array", "items": { "type": "string" } },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["what","why"],
        "properties": {
          "what": { "type": "string" },
          "why": { "type": "string" },
          "alternatives": { "type": "array", "items": { "type": "string" } },
          "timestamp": { "type": "string" }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim"],
        "properties": {
          "claim": { "type": "string" },
          "basis": { "type": "string" },
          "fragility": { "type": "string", "enum": ["low","medium","high"] },
          "validated": { "type": "boolean" }
        }
      }
    },
    "arguments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim","position","rationale"],
        "properties": {
          "claim": { "type": "string" },
          "position": { "type": "string" },
          "rationale": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "counterarguments": { "type": "array", "items": { "type": "string" } },
          "confidence": { "type": "string", "enum": ["low","medium","high"] },
          "confidence_basis": { "type": "string" },
          "status": { "type": "string", "enum": ["active","revised","superseded","rejected"] },
          "falsification_conditions": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "unknowns": { "type": "array", "items": { "type": "string" } },
    "verification": {
      "type": "object",
      "properties": {
        "checks": { "type": "array", "items": { "type": "string" } },
        "results": { "type": "string" },
        "residual_risks": { "type": "array", "items": { "type": "string" } }
      }
    },
    "iteration": { "type": "integer", "minimum": 0 },
    "parent_workflow_id": { "type": "string" },
    "handoff": {
      "type": "object",
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "payload": { "type": "object" }
      }
    }
  }
}
